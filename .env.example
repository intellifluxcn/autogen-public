# =============================================================================
# AI4MED AutoGen — Environment Variables
# =============================================================================
# Copy to .env and fill values: `cp .env.example .env`
#
# STARTUP FAIL-FAST: the backend refuses to start if any of these are missing
# (or AUTH_SECRET_KEY equals the demo default):
#   DATABASE_URL, AUTH_SECRET_KEY, OPENROUTER_API_KEY, LINKED_ACCOUNTS_KEY
# =============================================================================


# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autogen
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autogen_test

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=...

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating invalidates every stored paywall credential — users must re-link.
LINKED_ACCOUNTS_KEY=...

# https://openrouter.ai/keys — drives analysis + download stages
OPENROUTER_API_KEY=...


# -----------------------------------------------------------------------------
# OpenRouter (LLM gateway)
# -----------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-stage models (recommended: set both explicitly).
# If unset, each stage falls back to OPENROUTER_MODEL, then to the built-in
# constants in utils/llm_config.py (OPENROUTER_DEFAULT_MODEL /
# OPENROUTER_DEFAULT_DOWNLOAD_MODEL).
OPENROUTER_ANALYSIS_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_DOWNLOAD_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_MODEL=  # optional global fallback when per-stage vars are unset
# When the analyze primary model produces an LLM response that doesn't parse
# (typically a small model like flash-lite drifting on the ===MARKDOWN=== /
# ===PLAN_JSON=== boundary markers), the analyse stage re-invokes the LLM
# ONCE with this stronger fallback model for that single paper before
# accepting the degraded raw-output path. Leave unset to keep the previous
# single-shot behaviour. Recommend the next tier up: pro / opus / sonnet.
# ANALYSIS_FALLBACK_MODEL=google/gemini-3.1-pro-preview

# Pre-screen scorer. A lightweight title/abstract LLM gate that
# runs in Find between the heuristic ranker and the download loop. It scores
# every candidate 0-10 for likelihood of containing a paired expression +
# drug-response dataset, then drops papers below the threshold and re-sorts
# survivors by score. OPT-IN: prescreen is DISABLED unless
# PRESCREEN_SCORE_THRESHOLD is set — leaving it unset preserves current
# behavior with zero extra LLM cost.
# OPENROUTER_PRESCREEN_MODEL=google/gemini-3.1-flash-lite
# PRESCREEN_SCORE_THRESHOLD=6        # 0-10; unset disables prescreen entirely
# PRESCREEN_CONCURRENCY=8            # max concurrent scoring calls (semaphore)
# Failure policy: a single transient LLM failure RETAINS the paper (scored
# null, marked error) rather than dropping it ("rather over-analyze than
# wrongly kill"). But if the failure RATE exceeds PRESCREEN_FAILRATE_ABORT the
# prescreen ABORTS so Find fails loudly instead of silently retaining the whole
# pool on a systemic outage.
# PRESCREEN_FAILRATE_ABORT=0.5       # abort if >50% of candidates fail scoring
# NOTE: PRESCREEN_MAX_SCORE is intentionally NOT supported (deprecated). The
# scoring/cost scale is controlled by PRESCREEN_POOL_SIZE — the whole
# pool is always scored, never a front-N slice, so wide-net papers are never
# silently skipped.

# Attribution headers (optional)
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=AI4MED AutoGen


# -----------------------------------------------------------------------------
# Paper search — PubMed E-utilities (primary backend)
# -----------------------------------------------------------------------------
# NCBI contact email — REQUIRED by E-utilities Terms of Service. Falls back
# to UNPAYWALL_EMAIL with a CRITICAL log if unset; setting it explicitly is
# strongly recommended (NCBI may rate-limit / block IPs without a real
# contact email).
NCBI_EMAIL=...

# Optional: raises NCBI rate limit from 3 req/s to 10 req/s.
# Request one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=...

# Search backend feature flag. Default 'pubmed' (per-project setting in the
# DB is honoured). Override to 's2' to globally force the legacy backend
# (emergency rollback only — no redeploy needed):
#   systemctl edit ai4med-backend  →  Environment=SEARCH_BACKEND=s2  →  restart
# SEARCH_BACKEND=pubmed

# Wide-net candidate pool. Decouples how many papers Find
# fetches + ranks from max_papers (the download cap). UNSET / 0 falls back to
# the historical max_papers*3 — default behavior is unchanged. Set a large
# value (e.g. 20000) to cast a wide net: Find fetches and scores this many
# candidates before the download loop trims to max_papers. The pool never
# shrinks below max_papers*3 (it is a floor, applied via max()).
# PRESCREEN_POOL_SIZE=20000

# PubMed ESearch pagination depth for the fill-to-target loop.
# Default 3. Raise it for a wide net (PRESCREEN_POOL_SIZE >> max_papers*3) so
# the loop can page deep enough to fill the pool. WARNING: deep pagination
# multiplies NCBI E-utilities API calls and can trip rate limits — set
# NCBI_API_KEY (3→10 req/s) before raising this on large queries.
# PUBMED_MAX_PAGES=3

# Used for Unpaywall identification (rate-limited under the shared default).
# Also serves as fallback for NCBI_EMAIL if that is unset.
UNPAYWALL_EMAIL=...


# Per-paper download concurrency for the find stage. Default 1 (serial,
# matches historical behaviour). Set to 3-5 for large projects (max_papers
# in the hundreds or thousands) to roughly halve / quarter the find-stage
# wall time. Each in-flight download still runs on a worker thread, so the
# event loop stays free regardless of cap. Higher values are accepted but
# 10+ starts pressing Europe PMC / Unpaywall politeness limits.
# FIND_DOWNLOAD_CONCURRENCY=1

# Auto-pause every project after the find stage completes so the operator can
# review downloaded papers before the (more expensive) analyze + download
# stages kick in. Resume picks up at analyze. Off by default — leave unset
# (or set to "0" / "false" / "no" / "off") for end-to-end pipeline runs.
# PAUSE_AFTER_FIND=true


# -----------------------------------------------------------------------------
# Paper search — Semantic Scholar (deprecated / legacy)
# -----------------------------------------------------------------------------
# S2 is no longer the primary backend. Kept for:
#   1. Legacy projects (created before the PubMed cutover) — they store
#      search_backend='s2' in the projects table and continue to resume via S2.
#   2. SEARCH_BACKEND=s2 emergency rollback target.
# https://www.semanticscholar.org/product/api#api-key — 10 RPS with key.
# S2_API_KEY=...


# -----------------------------------------------------------------------------
# Auth & demo gate
# -----------------------------------------------------------------------------
# When true, seeds an admin account with a one-time random password printed
# to the server log on first start. Production keeps this unset.
# SEED_DEMO_USER=false

# Identity of the seeded admin (also the default project owner for CLI runs).
# Override with your hospital admin email / display name before first start.
# DEMO_ADMIN_EMAIL=doctor@ai4med.edu
# DEMO_ADMIN_NAME=Doctor

# Frontend URL embedded in password-reset emails.
# RESET_PASSWORD_URL=http://localhost:3000/reset-password


# -----------------------------------------------------------------------------
# Qualify stage — default OFF
# -----------------------------------------------------------------------------
# The qualify stage shells out to the Claude CLI to grade downloaded datasets.
# It is OFF by default; when unset/false the pipeline runs exactly as before
# (find→analyze→download→complete). Enable ONLY after Claude Code is installed
# AND authenticated (`claude login`) on the host — otherwise the qualify stage
# is recorded as an error (the project still completes).
# QUALIFY_ENABLED=false
# Path to the claude CLI binary. Defaults to bare "claude" (resolved via PATH).
# Set an ABSOLUTE path when the backend runs under systemd/cron, whose minimal
# PATH does not include ~/.local/bin (where claude installs) — otherwise the
# qualify health-check fails with "claude unavailable".
# QUALIFY_CLAUDE_BIN=/home/ubuntu/.local/bin/claude
# Qualify judge model ladder: run the cheaper PRIMARY model first and auto-
# escalate to the stronger one only when the primary can't produce a usable
# verdict (technical error, or it self-declares "VERDICT: escalate"). Accepts
# aliases (sonnet/opus/haiku) or full model IDs. Empty primary → CLI default;
# empty escalation → no escalation.
# QUALIFY_CLAUDE_MODEL=sonnet
# QUALIFY_CLAUDE_ESCALATION_MODEL=opus
# Reference gene set for the strict gene-overlap test. Defaults to the checked-in
# qualify/reference_genes.txt (1.0 expression feature universe, 60k+ ENSG IDs),
# copied into each dataset sandbox so claude can compute overlap deterministically.
# If the file is missing/empty, strict is unreachable (verdict capped at loose).
# QUALIFY_REFERENCE_GENE_SET_PATH=qualify/reference_genes.txt


# -----------------------------------------------------------------------------
# Known-DB direct retrieval — default OFF
# -----------------------------------------------------------------------------
# Driven from the web UI backend (web_ui/backend/orchestrator_integration.py),
# which IS part of this repository. Note that no mirror is shipped: set
# KNOWN_DB_MIRROR_BASE (further down) to a mirror of your own.
#
# Single papers almost never co-deposit a linkable expression (E) + drug-response
# (R) pair. When analyze detects a canonical pharmacogenomics DB (GDSC / CCLE-
# DepMap / PRISM), this fetches the canonical E+R+linkage straight from stable
# endpoints (figshare ndownloader, Sanger object store) — the only reliable source
# of a strict-gradable linkable triad. OFF by default; set true to enable (needed
# for the paper-driven path to yield strict datasets). These are large shared
# files (hundreds of MB) fetched once per project, hardlink-reused across DBs.
# KNOWN_DB_FETCH_ENABLED=false
# Per-file download timeout in seconds (default 900).
# KNOWN_DB_FETCH_TIMEOUT=900
# Per-file size cap in bytes (default ~1.2GB); skips a mislabeled giant file so it
# can't blow up disk. CCLE expression is ~430MB, so keep this comfortably above.
# KNOWN_DB_MAX_BYTES=1258291200


# -----------------------------------------------------------------------------
# Storage backend
# -----------------------------------------------------------------------------
# local | s3 | oss
STORAGE_BACKEND=local

# AWS S3 (when STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=...
# AWS_REGION=ap-southeast-1

# Aliyun OSS (when STORAGE_BACKEND=oss)
# ALIYUN_OSS_ACCESS_KEY_ID=...
# ALIYUN_OSS_ACCESS_KEY_SECRET=...
# ALIYUN_OSS_BUCKET=...
# ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com


# -----------------------------------------------------------------------------
# CORS (required for production)
# -----------------------------------------------------------------------------
# Comma-separated http(s)://host:port list. "*" is rejected at startup
# (conflicts with allow_credentials=True). Falls back to
# config/defaults.json when unset.
#
# Legacy alias (CORS_ALLOWED_ORIGINS takes precedence when both are set):
# CORS_ORIGINS=http://localhost:3000
#
# KNOWN ACCEPTED RISK: deployment runs over plain HTTP → JWTs in clear.


# -----------------------------------------------------------------------------
# Outbound email (contact-author + password reset) — skip if feature unused
# -----------------------------------------------------------------------------
# Generic SMTP — works with any provider (corporate Exchange, Tencent Exchange,
# Aliyun Mail, Outlook, Gmail, etc.). Port defaults to 587 for starttls / 465 for ssl.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=...
# SMTP_SENDER_EMAIL=noreply@example.com
# SMTP_SECURITY=starttls            # starttls | ssl | none


# -----------------------------------------------------------------------------
# MinerU (PDF → markdown; falls back to pdfplumber when unset)
# -----------------------------------------------------------------------------
# MINERU_API_TOKEN=...
MINERU_API_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=pipeline
MINERU_LANGUAGE=en
# MinerU has a daily quota; once exceeded, requests queue and may take minutes
# to hours to return. Pre-quota polls usually finish in < 60s; the high ceiling
# below keeps queued requests recoverable instead of falling back to the lossier
# pdfplumber path.
MINERU_TIMEOUT_SECONDS=3600
MINERU_POLL_INTERVAL_SECONDS=15
MINERU_MIN_MARKDOWN_CHARS=200
ANALYSIS_MAX_IMAGES=5
ANALYSIS_MAX_IMAGE_BYTES=4194304
# Per-paper analyze hard cap. MUST be > MINERU_TIMEOUT_SECONDS, otherwise the
# outer wrapper cancels the task while MinerU is still in queue.
ANALYZE_PER_PAPER_TIMEOUT_SECONDS=3700


# -----------------------------------------------------------------------------
# Download stage (browser automation)
# -----------------------------------------------------------------------------
# Profile cache root; set to "none" to disable on-disk profile dirs.
DOWNLOAD_AGENT_PROFILE_PATH=./browser_profile
DOWNLOAD_AGENT_TIMEOUT_SECONDS=300
DOWNLOAD_AGENT_TIMEOUT_GRACE_SECONDS=5
DOWNLOAD_AGENT_INTERNAL_TIMEOUT_RETRIES=1
DOWNLOAD_AGENT_STARTUP_RETRY_BACKOFF_SECONDS=5.0
DOWNLOAD_AGENT_NETWORK_IDLE_PAGE_LOAD_SECONDS=1.0
DOWNLOAD_AGENT_CROSS_ORIGIN_IFRAMES=true
DOWNLOAD_AGENT_CHROMIUM_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu,--no-first-run,--no-default-browser-check,--disable-dbus,--disable-background-networking
DOWNLOAD_DEBUG_FALLBACK_CAPTURE_SECONDS=3.0

# Storage upload retry (S3/OSS)
# DOWNLOAD_STORAGE_UPLOAD_ATTEMPTS=3
# DOWNLOAD_STORAGE_UPLOAD_RETRY_BACKOFF_SECONDS=2.0
# Aliyun OSS socket timeout (connect + read). Default 60s in oss2 is too aggressive
# for large files on flaky links — bump to ~180s to stop the 60s-timeout-retry loop.
OSS_CONNECT_TIMEOUT_SECONDS=180

# When using remote storage (oss/s3), drop the local copy after the upload
# succeeds AND the DB row is recorded. Prevents the local outputs/datasets/
# tree from doubling as a redundant cache and filling the disk (production
# hit a PG WAL-ENOSPC after only ~30 GB of multi-GB datasets accumulated).
# No-op for STORAGE_BACKEND=local. Set to ``false`` to keep both copies.
STORAGE_DELETE_LOCAL_AFTER_UPLOAD=true

# Advanced: attach to an external CDP endpoint instead of auto-launching
# a local Chromium. Use only when local browser-use auto-start fails.
# DOWNLOAD_AGENT_USE_CDP=true
# DOWNLOAD_AGENT_CDP_URL=http://127.0.0.1:9222
# DOWNLOAD_AGENT_LOCAL_CDP_STARTUP_TIMEOUT_SECONDS=30
# DOWNLOAD_AGENT_BROWSER_BINARY=/usr/bin/google-chrome


# -----------------------------------------------------------------------------
# Pipeline parallelism
# -----------------------------------------------------------------------------
# Force parallel mode for all browser-started projects (overrides per-project flag).
# PIPELINE_PARALLEL=true
# PIPELINE_MAX_PARALLEL=4
# NOTE: when MINERU_API_TOKEN is set and you're near the daily quota, drop this
# to 1 — concurrent submissions burn quota faster and push everything into the
# same queue, making each paper slower.


# -----------------------------------------------------------------------------
# Hardening tunables (defaults shown; uncomment to override)
# -----------------------------------------------------------------------------
# F1 — LLM call retry
# LLM_CALL_TIMEOUT_SECONDS=180
# LLM_CALL_MAX_ATTEMPTS=3

# F3 — pipeline shutdown bounds
# PIPELINE_SHUTDOWN_TIMEOUT_SECONDS=30
# TEAM_CLEANUP_TIMEOUT_SECONDS=20

# F4 — cancel→purge grace period
# CANCELLED_RETENTION_DAYS=7

# F8 — router short-circuit evidence guard
# ROUTER_MIN_EVIDENCE_COUNT=1

# S6 — rate-limit kill switch (leave on in production)
# RATE_LIMIT_ENABLED=true

# S9 — response headers + request body cap (4 MiB default)
# CONTENT_SECURITY_POLICY="default-src 'self'; img-src 'self' data:; ..."
# MAX_REQUEST_BODY_BYTES=4194304

# DB connection pool
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=20
# DB_POOL_CHECKOUT_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# AUTOGEN_VERBOSE=false

# Base URL of your own mirror of the derived (base-R converted) drug-response
# CSVs for CTRP / gCSI / GRAY / FIMM / UHNBreast / Tavor / Beat AML. These have
# no machine-readable upstream file — see analyze/known_resources.py and
# the README. Unset (the default) leaves those entries
# with url=None; no mirror is shipped with this repository.
# KNOWN_DB_MIRROR_BASE=https://example.org/ai4med-mirror
